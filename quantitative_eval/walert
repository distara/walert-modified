#!/usr/bin/env python3

"""
Walert command-line interface.
---------------------------
Walert has two main overall approaches:
 1. Intent Based: 
    Amazon Alexa recognises a predefined 'intent' and returns a predefined answer
 2. Retrieval-Augmented Generation (RAG)
    A search system retrieves relevant FAQ passages, then utilises an LLM for those passages to generate a natural language answer. 

This code currently rebuilds the RAG retrieval portion.
This looks something like: Data Files -> prepare -> BM25 index -> search -> ranged passages -> evaluate 

Falcon generation, dense retrieval, and alexa intent-based systers are To be Implemented.

Important Directory notes:
--------------------------
data/
  - Input data including: FAQ text, questions, and relevance judgements.

src/ 
  - Source code: Important instructions for preparing data, retrieving passages, generating answers
    evaluating results and running interfaces. 

target/ 
  - Stores artifacts including indexes as well as retrievals

target/repro
  - Temporary folder used for reproducing walert and reproducible from data/ and src/ 

Note: Original walert generated files still exist elsewhere in target/. and are used as reference
outputs to verify with while trying to reproduce walert. 
"""

from pathlib import Path
import argparse
import shutil
import subprocess
import sys

import pandas as pd


ROOT = Path(__file__).resolve().parent

DATA = ROOT / "data"
SRC = ROOT / "src"

TARGET = ROOT / "target"
REPRO = TARGET / "repro"

PREPARED = REPRO / "prepared"
BM25_COLLECTION_DIR = PREPARED / "bm25"
BM25_COLLECTION = BM25_COLLECTION_DIR / "collection.jsonl"
QRELS = PREPARED / "qrels.txt"

INDEXES = REPRO / "indexes"
BM25_INDEX = INDEXES / "bm25"

RUNS = REPRO / "runs"
BM25_RUN = RUNS / "rag-bm25.txt"

# Supplied authors' run. We currently use it only as a reference.
AUTHOR_BM25_RUN = TARGET / "runs" / "rag-bm25.txt"

TOPICS = DATA / "topics.csv"
COLLECTION = DATA / "collection.csv"
GROUNDTRUTH = DATA / "groundtruth.csv"

EVAL_SCRIPT = SRC / "retrieval" / "eval.py"

BM25_TAG = "walert.rag.bm25"
NUM_HITS = 100


def ensure_dirs():
    BM25_COLLECTION_DIR.mkdir(parents=True, exist_ok=True)
    INDEXES.mkdir(parents=True, exist_ok=True)
    RUNS.mkdir(parents=True, exist_ok=True)


def run(command):
    """Run an external command and stop if it fails."""
    print()
    print("+", " ".join(map(str, command)))
    subprocess.run(
        [str(x) for x in command],
        cwd=ROOT,
        check=True,
    )


def prepare():
    """
    Convert's Walert's dataset from human readable text into the required formats.
    This function DOES NOT search nor train the model.

    It converts:
    
	collection.csv -> collection.jsonl 
        (This format is one Pyserini/Lucene can use)

	+ 

	topics.csv + groundtruth.csv -> qrels.txt
	(This is essentially the answer used when evaluating retrieval.)
 
   This is a formatting and preperation function c: 
    """

    ensure_dirs()

    print("Preparing Walert retrieval data...")

    # ---------------------------------------------------------
    # Collection for Pyserini
    # ---------------------------------------------------------
    collection = pd.read_csv(COLLECTION)

    if len(collection.columns) != 2:
        raise RuntimeError(
            "collection.csv must contain exactly two columns."
        )

    collection.columns = ["id", "contents"]

    collection.to_json(
        BM25_COLLECTION,
        orient="records",
        lines=True,
    )

    print(
        f"  collection: {len(collection)} passages"
        f" -> {BM25_COLLECTION.relative_to(ROOT)}"
    )

    # ---------------------------------------------------------
    # Qrels
    # ---------------------------------------------------------
    topics = pd.read_csv(TOPICS)
    groundtruth = pd.read_csv(GROUNDTRUTH)

    merged = pd.merge(
        topics,
        groundtruth,
        on="topic_id",
    )

    merged["subtopic"] = 0

    qrels = merged[
        [
            "question_id",
            "subtopic",
            "passage_id",
            "relevance_judgment",
        ]
    ]

    qrels.to_csv(
        QRELS,
        sep="\t",
        index=False,
        header=False,
    )

    print(
        f"  qrels:      {len(qrels)} judgments"
        f" -> {QRELS.relative_to(ROOT)}"
    )

    print("\nPreparation complete.")


def index_bm25():
    """
    Builds our BM25 search index!!

    Input: Prepared FAQ passages

    Output: a Lucene index

    Note that the Lucene index is not a part of Walert's initial knowledge,
    it is essentially a lookup structure that is build and comes from that knowledge c: 
    - if it helps, think of it like a book index of our collection.csv data 

    Note note: this needs to be rebuilt if knowledge base changes!!! 
 
    """

    if not BM25_COLLECTION.exists():
        print(
            "Prepared collection is missing; "
            "running prepare first."
        )
        prepare()

    if BM25_INDEX.exists():
        print(
            f"Removing old index: "
            f"{BM25_INDEX.relative_to(ROOT)}"
        )
        shutil.rmtree(BM25_INDEX)

    BM25_INDEX.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    run(
        [
            sys.executable,
            "-m",
            "pyserini.index.lucene",
            "--collection",
            "JsonCollection",
            "--input",
            BM25_COLLECTION_DIR,
            "--language",
            "en",
            "--index",
            BM25_INDEX,
            "--generator",
            "DefaultLuceneDocumentGenerator",
            "--threads",
            "1",
            "--storePositions",
            "--storeDocvectors",
            "--storeRaw",
        ]
    )

    print(
        "\nBM25 index built at:",
        BM25_INDEX.relative_to(ROOT),
    )


def search_bm25():
    """
    Run all Walert evaluation questions against BM25.
    """

    from pyserini.search.lucene import LuceneSearcher

    if not BM25_INDEX.exists():
        raise RuntimeError(
            "BM25 index does not exist.\n"
            "Run: ./walert index bm25"
        )

    RUNS.mkdir(
        parents=True,
        exist_ok=True,
    )

    topics = pd.read_csv(TOPICS)
    searcher = LuceneSearcher(str(BM25_INDEX))

    print(
        f"Searching {len(topics)} Walert questions..."
    )

    total_results = 0

    with BM25_RUN.open(
        "w",
        encoding="utf-8",
    ) as output:

        for number, row in topics.iterrows():
            qid = str(row["question_id"])
            question = str(row["question"])

            hits = searcher.search(
                question,
                NUM_HITS,
            )

            total_results += len(hits)

            for rank, hit in enumerate(
                hits,
                start=1,
            ):
                output.write(
                    f"{qid} Q0 "
                    f"{hit.docid} "
                    f"{rank} "
                    f"{hit.score:.6f} "
                    f"{BM25_TAG}\n"
                )

            print(
                f"[{number + 1:3d}/{len(topics)}] "
                f"{qid}: {len(hits)} hits"
            )

    print(
        f"\nWrote {total_results} results to:"
    )
    print(
        f"  {BM25_RUN.relative_to(ROOT)}"
    )


def evaluate_bm25():
    """
    Grades all of the BM25 rankings
	- qrels.txt indicates which passages should be relevant 
        - rag-bm25.txt indicates which passages are actually retrieved by BM25
    NDCG compares our rankings,

    This evaluation only measures the search engine and does not alter it. 
    """

    if not QRELS.exists():
        raise RuntimeError(
            "Prepared qrels do not exist.\n"
            "Run: ./walert prepare"
        )

    if not BM25_RUN.exists():
        raise RuntimeError(
            "BM25 run does not exist.\n"
            "Run: ./walert search bm25"
        )

    print("\n=== KNOWN QUESTIONS ===")

    run(
        [
            sys.executable,
            EVAL_SCRIPT,
            "known",
            QRELS,
            BM25_RUN,
        ]
    )

    print("\n=== INFERRED QUESTIONS ===")

    run(
        [
            sys.executable,
            EVAL_SCRIPT,
            "inferred",
            QRELS,
            BM25_RUN,
        ]
    )


def compare_bm25():
    """
    Compare our newly reproduced BM25 rankings with the authors' supplied run.

    How close is our reproduction??
    """

    if not BM25_RUN.exists():
        raise RuntimeError(
            "Reproduced BM25 run does not exist."
        )

    if not AUTHOR_BM25_RUN.exists():
        print(
            "Authors' reference run was not found:"
        )
        print(
            f"  {AUTHOR_BM25_RUN}"
        )
        return False

    reproduced = BM25_RUN.read_bytes()
    reference = AUTHOR_BM25_RUN.read_bytes()

    reproduced_lines = len(
        reproduced.splitlines()
    )
    reference_lines = len(
        reference.splitlines()
    )

    print("\n=== REPRODUCTION CHECK ===")
    print(
        f"Reference rows:  {reference_lines}"
    )
    print(
        f"Reproduced rows: {reproduced_lines}"
    )

    if reproduced == reference:
        print()
        print(
            "SUCCESS: reproduced BM25 run is "
            "byte-for-byte identical to the "
            "authors' supplied run."
        )
        return True

    print()
    print(
        "WARNING: reproduced run differs from "
        "the authors' supplied run."
    )
    print(
        "Inspect with:"
    )
    print(
        "  diff -u "
        "target/runs/rag-bm25.txt "
        "target/repro/runs/rag-bm25.txt"
    )

    return False


def reproduce_bm25():
    """
    Perform + complete BM25 reproduction in the specified order:
	
	-> Prepare 
	-> Build new BM25 index
	-> run all test questions
	-> evaluate 
	-> compare with original walert output
    """

    print("=" * 64)
    print("Walert BM25 reproduction")
    print("=" * 64)

    prepare()
    index_bm25()
    search_bm25()
    evaluate_bm25()

    if not compare_bm25():
        sys.exit(1)


def show_status():
    """Show which reproduction artifacts currently exist."""

    items = [
        ("Prepared collection", BM25_COLLECTION),
        ("Prepared qrels", QRELS),
        ("BM25 index", BM25_INDEX),
        ("BM25 run", BM25_RUN),
        ("Authors' BM25 run", AUTHOR_BM25_RUN),
    ]

    print("Walert status\n")

    for label, path in items:
        state = "OK" if path.exists() else "MISSING"
        print(
            f"{state:7} "
            f"{label:22} "
            f"{path.relative_to(ROOT)}"
        )


def clean_repro():
    """Delete only generated reproduction artifacts."""

    if REPRO.exists():
        shutil.rmtree(REPRO)
        print(
            "Deleted target/repro/"
        )
    else:
        print(
            "target/repro/ does not exist."
        )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="walert",
        description="Build, reproduce, and run Walert.",
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser(
        "prepare",
        help="Generate derived retrieval files.",
    )

    index = sub.add_parser(
        "index",
        help="Build a retrieval index.",
    )
    index.add_argument(
        "retriever",
        choices=["bm25"],
    )

    search = sub.add_parser(
        "search",
        help="Run retrieval over Walert questions.",
    )
    search.add_argument(
        "retriever",
        choices=["bm25"],
    )

    evaluate = sub.add_parser(
        "evaluate",
        help="Evaluate a retrieval run.",
    )
    evaluate.add_argument(
        "retriever",
        nargs="?",
        default="bm25",
        choices=["bm25"],
    )

    reproduce = sub.add_parser(
        "reproduce",
        help="Run a complete reproduction pipeline.",
    )
    reproduce.add_argument(
        "retriever",
        choices=["bm25"],
    )

    sub.add_parser(
        "status",
        help="Show generated Walert artifacts.",
    )

    clean = sub.add_parser(
        "clean",
        help="Delete generated artifacts.",
    )
    clean.add_argument(
        "what",
        choices=["repro"],
    )

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "prepare":
        prepare()

    elif args.command == "index":
        if args.retriever == "bm25":
            index_bm25()

    elif args.command == "search":
        if args.retriever == "bm25":
            search_bm25()

    elif args.command == "evaluate":
        if args.retriever == "bm25":
            evaluate_bm25()

    elif args.command == "reproduce":
        if args.retriever == "bm25":
            reproduce_bm25()

    elif args.command == "status":
        show_status()

    elif args.command == "clean":
        if args.what == "repro":
            clean_repro()


if __name__ == "__main__":
    main()
